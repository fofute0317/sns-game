# ------------------------------------------------------------------
# Supabase（必須）
#   Supabase ダッシュボード > Project Settings > API から取得します。
# ------------------------------------------------------------------

# プロジェクトURL（例: https://xxxxxxxxxxxx.supabase.co）
# ブラウザにも渡るため NEXT_PUBLIC_ を付けます（Realtime購読に使用）
NEXT_PUBLIC_SUPABASE_URL=

# anon public key。ブラウザに公開されます。
# RLSにより、このキーだけではテーブルを読み書きできません（Realtime購読専用）。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key。**絶対にブラウザへ渡さないでください。**
# サーバ側（Vercel Functions）だけで使い、RLSをバイパスしてゲーム状態を更新します。
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# 任意
# ------------------------------------------------------------------

# /api/cron/sweep を保護するトークン。Vercel Cron が Authorization: Bearer で送ります。
CRON_SECRET=
